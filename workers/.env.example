# ============================================================
# WORKERS — Variables d'environnement (développement local)
# ============================================================
# Partagé par worker_parsing et worker_email
# ⚠️  Ne jamais committer ce fichier.

# ---------- Base de données ----------
DATABASE_URL=postgresql://ats:devpass@postgres:5432/ats_dev

# ---------- Redis ----------
REDIS_URL=redis://redis:6379
PARSING_QUEUE=parsing_jobs
EMAIL_QUEUE=email_jobs

# ---------- Stockage fichiers (CV) ----------
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/app/uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=ats-cv-local
S3_SIGNED_URL_EXPIRY=3600

# ---------- Parsing CV ----------
PARSING_TIMEOUT=30
PARSING_MAX_RETRIES=3
LOG_LEVEL=debug

# ---------- Email (SMTP) ----------
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ats-local.dev
SMTP_TLS=false