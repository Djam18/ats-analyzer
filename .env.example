# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Hugging Face
HUGGINGFACE_API_KEY=hf_your_api_key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
NUXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_your_pro_price_id
NUXT_PUBLIC_STRIPE_PRICE_EXPERT_MONTHLY=price_your_expert_price_id

# Resend (email)
RESEND_API_KEY=re_your_api_key

# App
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Admin (your email address — protects /admin routes)
NUXT_ADMIN_EMAIL=you@example.com
NUXT_PUBLIC_ADMIN_EMAIL=you@example.com
