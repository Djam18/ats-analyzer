# ============================================================
# BACKEND — Variables d'environnement (développement local)
# ============================================================
# ⚠️  Ne jamais committer ce fichier. Ajouter .env au .gitignore

# ---------- Base de données ----------
DATABASE_URL=postgresql://ats:devpass@postgres:5432/ats_dev
# Pour se connecter depuis l'hôte (hors Docker) :
# DATABASE_URL=postgresql://ats:devpass@localhost:5432/ats_dev

# ---------- Redis ----------
REDIS_URL=redis://redis:6379
PARSING_QUEUE=parsing_jobs
EMAIL_QUEUE=email_jobs

# ---------- Sécurité / Auth ----------
SECRET_KEY=dev_secret_key_unsafe_do_not_use_in_production
# Générer une vraie clé pour staging/prod :
# python -c "import secrets; print(secrets.token_hex(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- CORS / URLs autorisées ----------
FRONTEND_URL=http://localhost:3000
LANDING_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- Mode debug ----------
DEBUG=true
LOG_LEVEL=debug

# ---------- Stockage fichiers (CV) ----------
# En local : stockage sur disque. En prod : S3
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/app/uploads
# AWS (à remplir pour staging/prod uniquement)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=ats-cv-local
# Durée de validité des URLs signées (en secondes) — doc prévoit 1h
S3_SIGNED_URL_EXPIRY=3600

# ---------- Email (SMTP) ----------
# En local : MailHog sur port 1025 (pas de vrai envoi)
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ats-local.dev
SMTP_TLS=false
# Pour prod : SendGrid ou AWS SES
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=<sendgrid_api_key>
# SMTP_TLS=true

# ---------- Parsing CV ----------
# Délai max autorisé (en secondes) — doc : 30s
PARSING_TIMEOUT=30
PARSING_MAX_RETRIES=3

# ---------- RGPD ----------
# Hébergement France obligatoire (voir doc contraintes)
DATA_REGION=fr